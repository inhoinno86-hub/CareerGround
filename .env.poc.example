# Synthetic-only MCP OAuth probe. Copy to .env.poc; do not commit the filled file.
# Auth0 discovery issuer must end in /. Example: https://tenant.jp.auth0.com/
CAREERGROUND_POC_ISSUER=
# Exact HTTPS MCP resource identifier and Auth0 API Identifier.
# Direct servers use /mcp; OpenAI Secure MCP Tunnel uses /v1/mcp/tunnel_<id>.
# Copy the Resource field shown by ChatGPT OAuth discovery; do not infer its host.
CAREERGROUND_POC_RESOURCE_URL=
